{
  "name": "variety",
  "version": "1.5.2",
  "description": "A MongoDB schema analyzer",
  "keywords": [
    "MongoDB",
    "Variety",
    "schema",
    "schema analyzer",
    "schema analysis",
    "NoSQL"
  ],
  "homepage": "https://github.com/variety/variety#readme",
  "bugs": "https://github.com/variety/variety/issues",
  "license": "MIT",
  "author": {
    "name": "James Cropcho",
    "web": "https://x.com/Cropcho"
  },
  "contributors": [
    {
      "name": "Tomáš Dvořák",
      "email": "todvora@gmail.com",
      "web": "https://tomas-dvorak.cz/"
    },
    {
      "name": "Eve Freeman",
      "web": "https://github.com/freeeve"
    },
    {
      "name": "James Cropcho",
      "web": "https://x.com/Cropcho"
    }
  ],
  "files": [
    "variety.js",
    "bin/variety",
    "cli/"
  ],
  "main": "variety.js",
  "bin": "./bin/variety",
  "repository": {
    "type": "git",
    "url": "https://github.com/variety/variety.git"
  },
  "scripts": {
    "prepare": "husky",
    "build": "node build.js",
    "verify:build": "node build.js --check",
    "lint": "run-p lint:eslint lint:json lint:markdown lint:yaml lint:dockerfile lint:shell lint:spdx",
    "lint:eslint": "./node_modules/.bin/eslint --config .eslint.config.js . --cache --cache-strategy content",
    "lint:eslint:fix": "./node_modules/.bin/eslint --config .eslint.config.js . --fix --cache --cache-strategy content",
    "lint:json": "find . \\( -name node_modules -o -path './.git' -o -path './.claude/worktrees' -o -path './.worktrees' -o -path './worktrees' \\) -prune -o \\( -name '*.json' ! -name 'package-lock.json' -print0 \\) | xargs -0 ./node_modules/@prantlf/jsonlint/lib/cli.js -q",
    "lint:markdown": "./node_modules/.bin/markdownlint '**/*.md' '**/*.markdown' --ignore 'node_modules/**' --ignore '.claude/worktrees/**' --ignore '.worktrees/**' --ignore 'worktrees/**'",
    "lint:yaml": "git ls-files -z -- '*.yml' '*.yaml' | node scripts/lint-yaml.js",
    "lint:dockerfile": "hadolint docker/Dockerfile.template",
    "lint:shell": "shellcheck docker/init.sh test/bin/test-in-container.sh test/bin/mongosh-in-service-container.sh",
    "lint:spdx": "node scripts/check-spdx.js",
    "lint:pre-commit": "run-p verify:build lint typecheck",
    "typecheck": "./node_modules/.bin/tsc --project .tsconfig.checkjs.json",
    "test": "npm run lint:eslint && npm run test:container",
    "test:container": "./test/bin/test-in-container.sh",
    "test:mocha": "./node_modules/.bin/mocha --reporter spec --timeout 15000 --require test/helpers/mongod-liveness-hook.cjs \"test/**/*Test.js\""
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "diff": "^8.0.3",
    "@prantlf/jsonlint": {
      "ajv": "^8.18.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.1",
    "@prantlf/jsonlint": "^17.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "eslint": "^10.3.0",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "markdownlint-cli": "^0.48.0",
    "mocha": "^11.7.6",
    "mongodb": "^7.2.0",
    "npm-run-all2": "^8.0.4",
    "promisify-child-process": "^5.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
