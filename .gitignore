/node_modules/

# Local Git worktree parking areas; tooling also skips these from repo-root scans.
/.worktrees/
/worktrees/

# Generated from docker/Dockerfile.template for versioned test runs
/docker/Dockerfiles/*.Dockerfile

# Generated by test container (HOME redirected to project root)
/.npm/

# ESLint result cache (content-hashed; safe to delete, rebuilt on next lint run)
/.eslintcache

# Agent instruction files — managed locally and synced to a private backup, not committed to this repo
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/.claude/
/.codex/
